    {
      "id": "folk-vs-hubspot",
      "type": "owned",
      "publisher": "folk",
      "url": "https://folk.app/comparison/hubspot-alternative",
      "lang": "en",
      "priority": true,
      "why": "folk's own HubSpot comparison page: never cited in the 8 HubSpot-alternatives answers; undated and showing old prices.",
      "facts": [
        {
          "id": "premium-shown",
          "label": "folk Premium price shown (folk's pricing page says $48 billed yearly)",
          "pattern": "Price\\s*\\$\\d+ / seat / month\\s*\\$\\d+ / seat / month\\s*\\$(\\d+) / seat / month",
          "expected": "50",
          "used_in": "LinkedIn message 3; slide 4"
        },
        {
          "id": "hubspot-starter-shown",
          "label": "HubSpot Starter price shown (HubSpot advertises $7 billed annually)",
          "pattern": "Price\\s*\\$(\\d+) / seat / month",
          "expected": "20",
          "used_in": "Slide 4 footnote"
        },
        {
          "id": "standard-plan-mentioned",
          "label": "Mentions folk's $24 Standard plan",
          "pattern": "(Standard plan|Standard\\s*\\$\\d+)",
          "expect": "absent",
          "used_in": "LinkedIn message 3"
        }
      ]
    },
    {
      "id": "folk-pricing",
      "type": "facts",
      "publisher": "folk",
      "url": "https://www.folk.app/pricing",
      "lang": "en",
      "facts": [
        {
          "id": "folk-standard",
          "label": "folk Standard, per member per month, billed yearly",
          "pattern": "Standard[^$]{0,30}\\$(\\d+)[^/]{0,15}/member/month",
          "expected": "24",
          "used_in": "LinkedIn message 3; slide 4"
        },
        {
          "id": "folk-premium",
          "label": "folk Premium, per member per month, billed yearly",
          "pattern": "Premium[^$]{0,30}\\$(\\d+)[^/]{0,15}/member/month",
          "expected": "48",
          "used_in": "Slide 4 footnote"
        }
      ]
    },
    {
      "id": "hubspot-sales-pricing",
      "type": "facts",
      "publisher": "HubSpot",
      "url": "https://www.hubspot.com/pricing/sales",
      "lang": "en",
      "render": true,
      "facts": [
        {
          "id": "hubspot-starter",
          "label": "HubSpot Sales Hub Starter, from, per seat per month, billed annually",
          "pattern": "Starter[\\s\\S]{0,400}?Starts at\\s*(\\D{0,3}[\\d,]+)/mo/seat",
          "expected": "$7",
          "used_in": "Slide 4; doc Priority 1"
        },
        {
          "id": "hubspot-pro",
          "label": "HubSpot Sales Hub Professional, from, per seat per month, billed annually",
          "pattern": "Professional[\\s\\S]{0,400}?Starts at\\s*(\\D{0,3}[\\d,]+)/mo/seat",
          "expected": "$90",
          "used_in": "LinkedIn message 3; slide 4"
        },
        {
          "id": "hubspot-pro-onboarding",
          "label": "HubSpot Professional one-time onboarding fee",
          "pattern": "Professional Onboarding for a fee of (\\D{0,3}[\\d,]+)",
          "expected": "$1,500",
          "used_in": "LinkedIn message 3; slide 4"
        }
      ],
      "wait_for": "Starts at",
      "note": "HubSpot localises prices by IP. GitHub's US runners see USD; from another country the value shows that currency and is flagged as changed."
    }
  ]
